# NOVA Environment Configuration Template
# Copy this file to .env for local development overrides if desired.
# Note: In production, API keys are stored securely in your OS keychain via keyring.

# Optional Tier 2 Cloud Provider API Keys (Bring-Your-Own-Key)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Development Settings
NOVA_ENV=development
NOVA_LOG_LEVEL=DEBUG
